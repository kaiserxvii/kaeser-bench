{
  "name": "kaeser-bench",
  "version": "0.0.0",
  "description": "An open benchmark for evaluating whether AI-generated frontends follow a real design system.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiserxvii/kaeser-bench.git"
  },
  "bugs": {
    "url": "https://github.com/kaiserxvii/kaeser-bench/issues"
  },
  "homepage": "https://github.com/kaiserxvii/kaeser-bench#readme",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "commit": "cz",
    "commitlint": "commitlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version:next": "git-cliff --unreleased --bumped-version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "git-cliff": "2.13.1",
    "husky": "9.1.7",
    "typescript": "7.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
